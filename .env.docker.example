# Copy these into the Dokploy "Environment" tab for the app service.
# Do NOT commit a real .env with secrets.

APP_NAME=Datakita
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example.com
# Generate locally with: php artisan key:generate --show
APP_KEY=
APP_VERSION=2.1.0

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Point at the SEPARATE Dokploy MySQL service.
# DB_HOST is the internal service hostname Dokploy assigns to that service.
DB_CONNECTION=mysql
DB_HOST=datakita-mysql
DB_PORT=3306
DB_DATABASE=datakita
DB_USERNAME=datakita
DB_PASSWORD=change-me

# DB-backed: the file cache/session stores race across PHP-FPM workers and
# crash login with "fopen(...): Failed to open stream". The cache + sessions
# tables are created automatically by migrations on container boot.
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Traefik terminates HTTPS, so session cookies must carry the Secure flag.
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.example.com
MAIL_FROM_NAME="Datakita"

# SIBSTR Triwulanan reminder emails. BPS sets the schedule, targets and
# message at /bps/pengingat; this only decides whether THIS server may send.
# Set true ONLY on prod — datakitadev holds a copy of real respondent data.
# Links in the email are built from APP_URL, so it must be the public URL.
SIBSTR_REMINDER_ENABLED=false
# Sender address — must be on a domain verified with the mail provider.
SIBSTR_REMINDER_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
# Default Reply-To before BPS first saves the settings page.
SIBSTR_REMINDER_REPLY_TO=
# Leave empty to send through MAIL_* (Brevo). Set to "reminder" to send
# reminders through a separate SMTP account (e.g. Resend) instead:
SIBSTR_REMINDER_MAILER=
# REMINDER_MAIL_HOST=smtp.resend.com
# REMINDER_MAIL_PORT=587
# REMINDER_MAIL_USERNAME=resend
# REMINDER_MAIL_PASSWORD=re_xxxxxxxx
# REMINDER_MAIL_ENCRYPTION=tls

# MUST stay false in production. Local dev only.
DEV_AUTH_ENABLED=false

# Migrations run on every container boot by default (idempotent — `migrate --force`
# is a no-op when the schema is up to date, and uses --isolated to prevent races).
# Only set this to "false" as an emergency kill-switch (e.g. you're rolling back
# code and don't want the new schema applied).
RUN_MIGRATIONS=true

# ── Developer portal (/develop) ─────────────────────────────────────────────
# Off until the Traefik side is configured — see docs/DEVELOP_PORTAL.md.
DEVAPPS_ENABLED=false
DEVAPPS_MOUNT_PREFIX=
DEVAPPS_PUBLIC_HOST_URL="${APP_URL}"
# Dokploy names the app container after the Application; match it here.
DEVAPPS_FORWARD_AUTH_BASE=http://datakita-app
# Mount Dokploy's Traefik dynamic dir at this path (Advanced → Volumes) so the
# portal can write routing files itself. Leave empty for manual copy-paste.
DEVAPPS_TRAEFIK_DYNAMIC_PATH=/etc/dokploy/traefik/dynamic
DEVAPPS_MAX_PER_OWNER=5

# Dokploy API. Generate the key in Dokploy → Settings → API/CLI.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_PROJECT_ID=
