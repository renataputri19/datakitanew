APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=2.1.0

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Which route surface this container serves ───────────────────────────────
# Unset (or 'datakita') = DataKita only. This is what production runs, and it
# publishes no /develop routes at all.
#   all        both surfaces — datakitadev only, a dev convenience
#   devportal  the portal and its proxy only (apps.angkabatam.id)
# An unrecognised value is rejected at boot rather than assumed. See
# App\Support\AppRole.
APP_ROLE=

# ── Developer portal (/develop) ─────────────────────────────────────────────
# Lets BPS users mount apps from their own Git repos under this domain.
# See docs/DEVELOP_PORTAL.md. Off by default.
DEVAPPS_ENABLED=false
# '' mounts apps at the domain root (/survei-xyz); 'apps' mounts them under
# /apps/survei-xyz, which removes any chance of shadowing a datakita route.
DEVAPPS_MOUNT_PREFIX=
# Where the access gate runs. 'proxy' (default) means DataKita authorises and
# forwards each request itself — the only mode that works on this deployment,
# which has no Traefik. 'traefik' restores the edge forwardAuth design.
DEVAPPS_EDGE_MODE=proxy
# Timeouts for the hop to a dev app's container. Each proxied request holds a
# PHP-FPM worker, and pm.max_children is 20 — keep these short.
DEVAPPS_PROXY_CONNECT_TIMEOUT=5
DEVAPPS_PROXY_TIMEOUT=60
# Public URL apps are served on. Defaults to APP_URL.
DEVAPPS_PUBLIC_HOST_URL=
# traefik edge mode only — internal address Traefik calls to authorise each
# request. Must be the app container on the Docker network, never the public
# hostname. Unused in proxy mode.
DEVAPPS_FORWARD_AUTH_BASE=http://datakita-app
# traefik edge mode only — Traefik's dynamic config dir, mounted into this
# container so the portal can write one routing file per app.
DEVAPPS_TRAEFIK_DYNAMIC_PATH=
DEVAPPS_MAX_PER_OWNER=5

# Dokploy API — used to create and deploy the dev apps' containers.
# The token can create and delete applications: keep it out of the repo.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_PROJECT_ID=
